# Backend API Key (Required for server/index.js)
GEMINI_API_KEY=your_gemini_api_key_here

# CORS: Comma-separated list of allowed origins (Optional, defaults to localhost ports)
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://myapp.com

# Frontend API URL (Optional, defaults to relative path for web)
# VITE_API_URL=http://localhost:3000
